# 둘 중 하나만 설정하면 됩니다.
# 1) Claude API 키 (https://console.anthropic.com 에서 발급, 종량제 크레딧 필요)
ANTHROPIC_API_KEY=your-api-key-here

# 2) Claude Code 구독 OAuth 토큰 (터미널에서 `claude setup-token` 실행 후 출력된 값, 크레딧 불필요)
CLAUDE_CODE_OAUTH_TOKEN=your-oauth-token-here

# (선택) Codex 협업 에이전트용 OpenAI Codex 인증.
# 보통은 대시보드 헤더의 "Codex 로그인"(ChatGPT 계정, 기기 인증 코드)으로 하고 자격증명은 ~/.codex/auth.json 에 저장된다.
# API 키로 쓰려면 아래 값을 넣는다 (이 경우 대시보드에서 로그아웃 불가).
# CODEX_API_KEY=

# 서버 포트
PORT=3000

# (선택) 휴대폰 등 같은 와이파이의 다른 기기에서 접속하기 위한 비밀번호 (8자 이상).
# 설정하면 서버를 네트워크에 열고(HOST, 기본 0.0.0.0), 이 컴퓨터가 아닌 기기는 이 비밀번호로 로그인해야 쓸 수 있다.
# 비워두면 지금처럼 이 컴퓨터(localhost)에서만 접속된다. 휴대폰에서는 http://<이 컴퓨터의 IP>:3100 으로 연다 (서버 시작 로그에 주소가 나온다).
# 에이전트가 이 컴퓨터에서 명령을 실행할 수 있으므로, 믿을 수 있는 네트워크에서만 켜고 추측하기 어려운 비밀번호를 쓴다.
ACCESS_PASSWORD=

# 에이전트가 파일을 읽고 쓸 작업 폴더의 기본값 (이 폴더 밖은 건드리지 않도록 설정됨)
# 대시보드 상단의 폴더 칩이나 /workspace <경로> 명령으로 바꿀 수 있고, 바꾼 값은 data/settings.json에 저장된다
WORKSPACE_DIR=./workspace

# 파일 수정 권한 모드
#   acceptEdits : 작업 폴더 안의 파일 생성/수정은 자동 허용, 명령 실행은 화면에서 승인 (기본값)
#   default     : 파일 수정도 모두 화면에서 승인
PERMISSION_MODE=acceptEdits

# 사용할 모델 (비워두면 기본 모델)
MODEL=

# 한 번의 명령에서 총괄 에이전트가 쓸 수 있는 최대 턴 수
MAX_TURNS=60

# 명령 하나에 쓸 수 있는 최대 비용(달러). 넘으면 작업을 멈춘다.
MAX_BUDGET_USD=2

# 명령에 첨부한 업로드 파일(workspace/uploads) 보관 일수. 지나면 자동 삭제, 0이면 정리 안 함 (기본 7)
UPLOAD_RETENTION_DAYS=7
