{
  "name": "agent-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "명령을 내리면 여러 Claude 에이전트가 협업하고, 그 과정을 실시간으로 보여주는 대시보드",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/fix-node-pty-perms.mjs",
    "test": "tsc -p tsconfig.spec.json && node --test 'dist-test/test/**/*.test.js'"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.273",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/platform-socket.io": "^12.0.3",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/websockets": "^12.0.3",
    "@openai/codex-sdk": "^0.155.0",
    "dotenv": "^17.4.2",
    "node-pty": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.3",
    "typescript": "~6.0.2"
  }
}
