; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="서울 거리 프로젝트"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7")

[autoload]

InputSetup="*res://scripts/core/input_setup.gd"
WebRuntime="*res://scripts/core/web_runtime.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/mode.web="viewport"

[gui]

theme/custom_font.web="res://assets/fonts/NotoSansKR.ttf"

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.11, 1)
